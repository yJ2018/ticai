# ─────────────────────────────────────────────────────────────
# ticai BFF 配置（仅服务端读取，不会打进前端 bundle）
# 复制为 .env 后填写真实密钥；.env 已被 gitignore，不要提交
# ─────────────────────────────────────────────────────────────

# BFF 监听地址与端口（Vite dev 会把 /api 代理到这里）
HOST=127.0.0.1
PORT=3000

# 是否在 BFF 内托管 dist 静态资源（生产同源部署时保持 1）
SERVE_STATIC=1

# 上游超时（毫秒）
UPSTREAM_TIMEOUT_MS=8000

# 聚合数据：天气 / 星座 / IP 归属地
JUHE_WEATHER_KEY=
JUHE_HOROSCOPE_KEY=
JUHE_IP_KEY=

# ─────────────────────────────────────────────────────────────
# DeepSeek 大模型（仅服务端读取，不要加 VITE_ 前缀）
# 密钥申请：https://platform.deepseek.com/api_keys
# 填好后可先执行 npm run ai:check 验证连通性
# ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 上游超时（毫秒）；思考模式下建议不低于 60000
DEEPSEEK_TIMEOUT_MS=60000
# 未显式传 maxTokens 时的默认输出上限
DEEPSEEK_MAX_TOKENS=1024
# 1 = 默认开启思考模式（更慢、更贵，分析类任务可开）；0 = 关闭
DEEPSEEK_THINKING=0
# /api/ai-chat 每个 IP 每分钟最多调用次数，0 = 不限制（单实例内存限流）
AI_RATE_LIMIT_PER_MIN=10
# /api/venue-weather 每个 IP 每分钟最多调用次数（会触发一次轻量城市解析）
VENUE_RATE_LIMIT_PER_MIN=20

# 上游地址（一般无需修改；改成本地 mock 可用于联调）
SPORTTERY_BASE=https://webapi.sporttery.cn
JUHE_WEB_BASE=http://web.juhe.cn
JUHE_WEATHER_BASE=http://v.juhe.cn
JUHE_IP_BASE=http://apis.juhe.cn
