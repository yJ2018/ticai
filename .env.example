# ─────────────────────────────────────────────────────────────
# ticai 服务端配置（API 与爬虫读取，不会打进前端 bundle）
# 复制为 .env 后填写真实密钥；.env 已被 gitignore，不要提交
# ─────────────────────────────────────────────────────────────

# API 监听地址与端口（Vite dev 会把 /api 代理到这里）
API_HOST=127.0.0.1
API_PORT=3001

# 允许跨域的前端来源，逗号分隔；生产填前端域名
CORS_ORIGINS=http://localhost:5173

# 上游超时（毫秒）
UPSTREAM_TIMEOUT_MS=8000

# 聚合数据：天气 / 星座 / IP 归属地
JUHE_WEATHER_KEY=
JUHE_HOROSCOPE_KEY=
JUHE_IP_KEY=

# ─────────────────────────────────────────────────────────────
# DeepSeek 大模型（仅服务端读取，不要加 VITE_ 前缀）
# 密钥申请：https://platform.deepseek.com/api_keys
# 填好后可先执行 npm run ai:check 验证连通性
# ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 上游超时（毫秒）；思考模式下建议不低于 60000
DEEPSEEK_TIMEOUT_MS=60000
# 未显式传 maxTokens 时的默认输出上限
DEEPSEEK_MAX_TOKENS=1024
# 1 = 默认开启思考模式（更慢、更贵，分析类任务可开）；0 = 关闭
DEEPSEEK_THINKING=0
# /api/ai-chat 每个 IP 每分钟最多调用次数，0 = 不限制（单实例内存限流）
AI_RATE_LIMIT_PER_MIN=10
# /api/venue-weather 每个 IP 每分钟最多调用次数（会触发一次轻量城市解析）
VENUE_RATE_LIMIT_PER_MIN=20

# 上游地址（一般无需修改；改成本地 mock 可用于联调）
SPORTTERY_BASE=https://webapi.sporttery.cn
JUHE_WEB_BASE=http://web.juhe.cn
JUHE_WEATHER_BASE=http://v.juhe.cn
JUHE_IP_BASE=http://apis.juhe.cn

# ────────────────────────────────────────────────────────────────────────────
# 数据库（仅服务端与爬虫读取，不要加 VITE_ 前缀）
# 迁移与自检：npm run db:migrate / npm run db:status / npm run db:verify
# ────────────────────────────────────────────────────────────────────────────
# PostgreSQL 连接串。Neon 请用带 -pooler 的主机名，避免 serverless 连接数打满。
# 本地示例：postgres://postgres:postgres@127.0.0.1:5432/ticai
DATABASE_URL=
# 云数据库需要 TLS：1 = 启用（不校验证书链），0 = 关闭，留空 = 由连接串参数决定
DATABASE_SSL=

# ────────────────────────────────────────────────────────────────────────────
# 前端 → API 地址（构建期注入）
# 留空 = 同源：本地由 Vite 代理到 3001，生产可走同域 rewrite
# 前后端分开部署时填 API 域名，例如 https://ticai-api.vercel.app
# ⚠️ VITE_ 前缀会打进浏览器 bundle，这里只能放域名，绝不能放密钥
# ────────────────────────────────────────────────────────────────────────────
VITE_API_BASE=

# ────────────────────────────────────────────────────────────────────────────
# 本地爬虫调度（仅 npm run crawl:daemon 使用）
# ────────────────────────────────────────────────────────────────────────────
# 赔率变化快，在售赛程单独提速
CRAWL_MATCHES_MINUTES=30
# 开奖与对战数据（伤停/赛果）的整轮间隔
CRAWL_INTERVAL_MINUTES=180
# 竞彩销售时段（北京时间），非销售时段不抓比赛相关数据
BET_WINDOW_WEEKDAY=11:00-22:00
BET_WINDOW_WEEKEND=11:00-23:00
# 阵容是否也遵守销售时段；0 = 允许在停售时段抓（凌晨场次的官方名单在停售时段公布）
CRAWL_LINEUPS_GATE=1
# 每天几点（北京时间）跑一轮「仅体彩官网数据」的预热，不受销售时段限制
CRAWL_DAILY_HOUR=9
# 单条 SQL 上限（毫秒）：跨境写库时 49 场批量 upsert 能到 90 秒以上
CRAWL_STATEMENT_TIMEOUT_MS=180000
