{
  "name": "ticai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "dev:api": "node apps/api/src/index.mjs",
    "build": "next build",
    "web:start": "next start",
    "start": "node apps/api/src/index.mjs",
    "ai:check": "node scripts/ai-smoke.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "architecture:update": "node scripts/update-architecture.mjs",
    "analyze:snapshot": "node scripts/analyze-snapshot.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-migrate.mjs seed",
    "db:status": "node scripts/db-migrate.mjs status",
    "db:verify": "node scripts/db-migrate.mjs verify",
    "api:dev": "node apps/api/src/index.mjs",
    "api:test": "node --test apps/api/test",
    "analysis:dev": "node scripts/analysis-dev.mjs",
    "analysis:test": "node scripts/analysis-test.mjs",
    "analysis:fixtures": "node scripts/export-analysis-fixtures.mjs && node scripts/export-lottery-fixtures.mjs && node scripts/export-ai-fixtures.mjs",
    "crawl": "node apps/crawler/src/index.mjs",
    "crawl:matches": "node apps/crawler/src/index.mjs matches",
    "crawl:history": "node apps/crawler/src/index.mjs history",
    "crawl:details": "node apps/crawler/src/index.mjs details",
    "crawl:daemon": "node apps/crawler/src/daemon.mjs",
    "crawl:lineups": "node apps/crawler/src/index.mjs lineups-browser --run",
    "crawl:test": "node --test apps/crawler/test",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "deploy": "npm run deploy:local && npm run deploy:api",
    "deploy:local": "node scripts/deploy-local.mjs",
    "deploy:api": "node scripts/deploy-api.mjs",
    "deploy:analysis": "node scripts/deploy-analysis.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "zustand": "^5.0.12"
  }
}
